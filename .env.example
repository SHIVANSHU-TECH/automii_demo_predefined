# Telegram Bot API token from @BotFather (required)
BOT_TOKEN=your_telegram_bot_token_here

# mock = predefined demos.json scripts/videos
# live = Claude Code + ai-reel-updated-final + Google Flow MCP
BOT_MODE=mock

# Optional: default Cloudinary MP4 URL used only if a mock demo omits videoUrl
# DEFAULT_VIDEO_URL=https://res.cloudinary.com/YOUR_CLOUD/video/upload/v1234567890/sample.mp4

# --- Live mode (required when BOT_MODE=live) ---
SPENDING_POLICY_ENABLED=true
MAX_VIDEO_JOBS_PER_USER_PER_DAY=3
MAX_VIDEO_JOBS_PER_DAY=10
MAX_PAID_ATTEMPTS_PER_JOB=1
# Claude Code API USD cap (--max-budget-usd). Does NOT cap Flow/HeyGen/ElevenLabs account balances.
# Full STUDIO_COMPOSITE (Flow V-rolls + Studio + post) typically needs ~35–40 USD Claude API per job
# because each Flow MCP page call is large; too-low caps return CLAUDE_BUDGET_TOO_LOW (no presenter-only fallback).
MAX_CLAUDE_BUDGET_USD_PER_JOB=40
MAX_CLAUDE_BUDGET_USD_PER_DAY=120
# Operator-configured Google Flow credit ceiling enforced in the bot-mode prompt (live quote check).
# ~10 credits per 6s clip; a 4–6 clip plan needs ~40–70. Cap must cover the planned V-rolls.
MAX_FLOW_CREDITS_PER_JOB=80

# STUDIO_COMPOSITE uses Google Flow V-rolls; PRESENTER_ONLY skips Flow (HeyGen presenter only).
COMPOSITION_PATH=STUDIO_COMPOSITE
CLAUDE_SKILL_NAME=ai-reel-updated-final
CLAUDE_BIN=claude
CLAUDE_PERMISSION_MODE=bypassPermissions

# Safety / queue
PRIVATE_CHATS_ONLY=true
MAX_QUEUE_LENGTH=20
MAX_ACTIVE_JOBS_PER_USER=2
SCRIPT_TIMEOUT_MS=1200000
VIDEO_TIMEOUT_MS=5400000
DISPATCHER_POLL_MS=1500

# Persistence (gitignored runtime/)
# RUNTIME_DIR=./runtime
# SQLITE_PATH=./runtime/automii.sqlite
# JOBS_WORKSPACE_DIR=./runtime/jobs

# Set to 1 to exercise the worker without calling Claude / spending credits
CLAUDE_DRY_RUN=0
